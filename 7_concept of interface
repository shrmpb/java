interface A
{
   void showA();
}

interface B
{
   void showB();
}
class C implements A, B    
{
   public void showA()
   {
      System.out.println("Interface A");
   }

   public void showB()
   {
      System.out.println(" Interface B");
   }
}

public class interface1
{
   public static void main(String[] args) {
      C c1 = new C();
      c1.showA();
      c1.showB();
   }
}
